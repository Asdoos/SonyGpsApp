<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FF121212">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sony GPS Link"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sendet GPS-Koordinaten via BLE an Sony-Kameras"
        android:textColor="#FF888888"
        android:textSize="12sp"
        android:paddingBottom="16dp"/>

    <!-- Status card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FF1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STATUS"
            android:textColor="#FF888888"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nicht verbunden"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"/>

    </LinearLayout>

    <!-- GPS card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FF1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS"
            android:textColor="#FF888888"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/tvGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FF00CC66"
            android:textSize="14sp"
            android:fontFamily="monospace"/>

    </LinearLayout>

    <!-- Camera card: remembered camera, auto-connect, GPX recording -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FF1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KAMERA"
            android:textColor="#FF888888"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/tvCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keine Kamera gespeichert"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConnectLast"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/text_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verbinden"
                android:enabled="false"/>

            <Button
                android:id="@+id/btnForget"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/text_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vergessen"
                android:enabled="false"/>

        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAutoConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Automatisch verbinden, wenn die Kamera in der Nähe ist"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:paddingVertical="4dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swRecordTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS-Track aufzeichnen (GPX)"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:paddingVertical="4dp"/>

        <Button
            android:id="@+id/btnTracks"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/text_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tracks teilen"/>

    </LinearLayout>

    <!-- App version + update check -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Version —"
            android:textColor="#FF888888"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnCheckUpdate"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/text_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nach Updates suchen"/>

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kamera suchen"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trennen"
            android:enabled="false"/>

    </LinearLayout>

    <!-- Log -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LOG"
        android:textColor="#FF888888"
        android:textSize="10sp"
        android:letterSpacing="0.15"
        android:paddingBottom="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF1E1E1E"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FFAAAAAA"
            android:fontFamily="monospace"
            android:text=""/>

    </ScrollView>

</LinearLayout>
