<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 palette, light. Dark counterparts live in values-night/colors.xml.
     On Android 12+ the system wallpaper colours replace the primary/secondary
     roles (DynamicColors in SonyGpsApp); the status colours below stay fixed. -->
<resources>
    <color name="md_primary">#FF0057A8</color>
    <color name="md_on_primary">#FFFFFFFF</color>
    <color name="md_primary_container">#FFD5E3FF</color>
    <color name="md_on_primary_container">#FF001B3E</color>

    <color name="md_secondary">#FF545F71</color>
    <color name="md_on_secondary">#FFFFFFFF</color>
    <color name="md_secondary_container">#FFD8E3F8</color>
    <color name="md_on_secondary_container">#FF111C2B</color>

    <color name="md_error">#FFBA1A1A</color>
    <color name="md_on_error">#FFFFFFFF</color>
    <color name="md_error_container">#FFFFDAD6</color>
    <color name="md_on_error_container">#FF410002</color>

    <color name="md_background">#FFF8F9FF</color>
    <color name="md_on_background">#FF191C20</color>
    <color name="md_surface">#FFF8F9FF</color>
    <color name="md_on_surface">#FF191C20</color>
    <color name="md_surface_variant">#FFE0E2EC</color>
    <color name="md_on_surface_variant">#FF43474E</color>
    <color name="md_outline">#FF74777F</color>
    <color name="md_outline_variant">#FFC4C6CF</color>
    <color name="md_surface_container_lowest">#FFFFFFFF</color>
    <color name="md_surface_container_low">#FFF2F4FA</color>
    <color name="md_surface_container">#FFECEEF4</color>
    <color name="md_surface_container_high">#FFE6E8EE</color>
    <color name="md_surface_container_highest">#FFE0E2E9</color>

    <!-- Session state colours (not part of the dynamic palette) -->
    <color name="status_active">#FF1E7B3C</color>
    <color name="status_active_container">#FFD3F3DA</color>

    <!-- Launcher icon background -->
    <color name="launcher_background">#FF0057A8</color>
</resources>
